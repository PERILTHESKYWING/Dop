# Server-side only. Set these in your host's environment variables (e.g. Vercel:
# Project Settings > Environment Variables). Never prefix them with VITE_, and never commit a real key.
LLM_PROVIDER=Google AI Studio
# "Gemini" picks the default current Gemini model; or give an exact id such as gemini-2.5-flash.
LLM_MODEL=Gemini
LLM_API_KEY=your-google-ai-studio-key-here

# Optional accounts (Account & Sync). Vercel's Upstash for Redis integration sets these for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Local development without a database: keep accounts in memory.
# ACCOUNT_STORE=memory
