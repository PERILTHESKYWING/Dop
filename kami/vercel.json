{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && npm run kami:build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':/' ':(exclude,top)docs' ':(exclude,top).claude' ':(exclude,top).claude-plugin' ':(exclude,top).github' ':(exclude,top)hub' ':(exclude,top)eval' ':(exclude,top)data' ':(exclude,top)README.md' ':(exclude,top)CLAUDE.md' ':(exclude,top)THIRD_PARTY_NOTICES.md' ':(exclude,top)public/student' ':(exclude,top)public/book' ':(exclude,top)public/level' ':(exclude,top)public/coach' ':(exclude,top)public/problems' ':(exclude,top)public/broadcast' ':(exclude,top)public/pc-helper' ':(exclude,top)public/downloads' ':(exclude,top)tools' ':(exclude,top)scripts' ':(exclude,top)tests'",
  "rewrites": [
    {
      "source": "/katago-models/:path*",
      "destination": "https://media.katagotraining.org/uploaded/networks/models/kata1/:path*"
    },
    {
      "source": "/((?!api/|engine/|models/|art/|assets/|katago-models/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
