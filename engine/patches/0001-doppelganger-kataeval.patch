+// DOPPELGANGER PATCH: batched move-sequence eval. Like kgeEvalSeq (full move history,
+// ko, recent-move features) for numPos positions in ONE forward pass. Position i replays
+// moveLocs/moveCols[offsets[i] .. offsets[i+1]) and is evaluated for plas[i] under
+// symmetry syms[i] (0..7; the backend un-transforms its outputs, so averaging a position
+// over several symmetries reduces the net's orientation noise). Values are for the side
+// to move, as kgeEvalSeq. ownerOut: numPos*hw (white perspective) or NULL.
+KATAEVAL_EXPORT int kgeEvalSeqBatch(const int* moveLocs, const int* moveCols, const int* offsets,
+                                    const int* plas, const int* syms, int numPos, double komi,
+                                    float* policyOut, float* valueOut, float* ownerOut) {
+  if(gHandle == nullptr) { gErr = "not loaded"; return 0; }
+  if(numPos < 1 || numPos > KGE_MAX_BATCH) { gErr = "batch size out of range"; return 0; }
+  try {
+    const int hw = gXLen * gYLen;
+    std::vector<Board> boards(numPos);
+    std::vector<BoardHistory> hists(numPos);
+    const int spatialLen = NNModelVersion::getNumSpatialFeatures(gModelVersion) * gXLen * gYLen;
+    const int globalLen = NNModelVersion::getNumGlobalFeatures(gModelVersion);
+    std::vector<NNResultBuf> bufs(numPos);
+    std::vector<NNResultBuf*> bufPtrs(numPos);
+    std::vector<NNOutput> outs(numPos);
+    std::vector<NNOutput*> outPtrs(numPos);
+    MiscNNInputParams nnInputParams; nnInputParams.policyOptimism = gPolicyOptimism;
+    for(int i = 0; i < numPos; i++) {
+      const int a = offsets[i], b = offsets[i + 1];
+      buildBoardHist(moveLocs + a, moveCols + a, b - a, komi, boards[i], hists[i]);
+      bufs[i].rowSpatialBuf.resize(spatialLen);
+      bufs[i].rowGlobalBuf.resize(globalLen);
+      bufs[i].hasRowMeta = false;
+      bufs[i].symmetry = syms ? (syms[i] & 7) : 0;
+      bufs[i].policyOptimism = gPolicyOptimism;
+      NNInputs::fillRowV7(boards[i], hists[i], (Player)plas[i], nnInputParams, gXLen, gYLen,
+                          gUseNHWC, bufs[i].rowSpatialBuf.data(), bufs[i].rowGlobalBuf.data());
+      bufPtrs[i] = &bufs[i];
+      outs[i].nnXLen = gXLen; outs[i].nnYLen = gYLen;
+      outs[i].whiteOwnerMap = ownerOut ? ownerOut + (size_t)i * hw : nullptr;
+      outPtrs[i] = &outs[i];
+    }
+    NeuralNet::getOutput(gHandle, gInputs, numPos, bufPtrs.data(), outPtrs);
+    for(int i = 0; i < numPos; i++) {
+      std::memcpy(policyOut + (size_t)i * (hw + 1), outs[i].policyProbs, (hw + 1) * sizeof(float));
+      valueOut[i*5+0] = outs[i].whiteWinProb;
+      valueOut[i*5+1] = outs[i].whiteLossProb;
+      valueOut[i*5+2] = outs[i].whiteNoResultProb;
+      valueOut[i*5+3] = outs[i].whiteScoreMean;
+      valueOut[i*5+4] = outs[i].whiteLead;
+      outs[i].whiteOwnerMap = nullptr;  // caller-owned
+    }
+    return 1;
+  } catch(const std::exception& e) {
+    gErr = e.what();
+    return 0;
+  }
+}
