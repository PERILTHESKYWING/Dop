+// DOPPELGANGER PATCH: root children of the last kgeSearch, most visited first.
+// winrates are for the side to move at the root. Returns the number written.
+KATAEVAL_EXPORT int kgeRootStats(int* movesOut, int* visitsOut, float* winratesOut, float* priorsOut, int cap) {
+  int n = std::min(cap, (int)gRootStats.size());
+  for(int i = 0; i < n; i++) {
+    movesOut[i] = gRootStats[i].move; visitsOut[i] = gRootStats[i].visits;
+    winratesOut[i] = gRootStats[i].winrate; priorsOut[i] = gRootStats[i].prior;
+  }
+  return n;
