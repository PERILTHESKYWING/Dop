+// DOPPELGANGER PATCH: root children of the last kgeSearch, most visited first.
+// winrates are for the side to move at the root. Returns the number written.
+KATAEVAL_EXPORT int kgeRootStats(int* movesOut, int* visitsOut, float* winratesOut, float* priorsOut, int cap) {
+  int n = std::min(cap, (int)gRootStats.size());
+  for(int i = 0; i < n; i++) {
+    movesOut[i] = gRootStats[i].move; visitsOut[i] = gRootStats[i].visits;
+    winratesOut[i] = gRootStats[i].winrate; priorsOut[i] = gRootStats[i].prior;
+  }
+  return n;
+}
+
+// DOPPELGANGER PATCH: the model's output post-processing constants, so the caller
+// can scale raw scores/ownership exactly as KataGo's NNEvaluator does.
+// out[0..3] = {outputScaleMultiplier, scoreMeanMultiplier, leadMultiplier, scoreStdevMultiplier}
+KATAEVAL_EXPORT int kgePostProcessParams(float* out) {
+  if(gModel == nullptr) { gErr = "not loaded"; return 0; }
+  const ModelDesc& d = NeuralNet::getModelDesc(gModel);
+  out[0] = d.postProcessParams.outputScaleMultiplier;
+  out[1] = (float)d.postProcessParams.scoreMeanMultiplier;
+  out[2] = (float)d.postProcessParams.leadMultiplier;
+  out[3] = (float)d.postProcessParams.scoreStdevMultiplier;
+  return 1;
+}
