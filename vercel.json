{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!docs' ':!.claude' ':!.claude-plugin' ':!.github' ':!hub' ':!eval' ':!data' ':!README.md' ':!CLAUDE.md' ':!THIRD_PARTY_NOTICES.md' ':!scripts' ':!tests'",
  "rewrites": [
    { "source": "/katago-models/:path*", "destination": "https://media.katagotraining.org/uploaded/networks/models/kata1/:path*" },
    { "source": "/((?!api/|engine/|demo/|assets/|katago-models/|book/|downloads/|pc-helper/|student/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/engine/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/book/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/student/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
